@startuml
!include <C4/C4_Component>
title Діаграма компонентів (C4, рівень 3): модулі серверного застосунку та їхні залежності
LAYOUT_TOP_DOWN()
HIDE_STEREOTYPE()

Boundary(сервер, "Серверний застосунок (модульний моноліт)", "контейнер") {
  Component(сповіщення, "Модуль «Сповіщення»", "Java-пакет", "Слухає події інших модулів, формує сповіщення\nCa = 0, Ce = 4, I = 1,00")
  Component(доставка, "Модуль «Доставка»", "Java-пакет", "Диспетчер, пропозиції, відстеження курʼєрів\nCa = 1, Ce = 2, I = 0,67")
  Component(замовлення, "Модуль «Замовлення»", "Java-пакет", "Кошик, оформлення, статуси замовлень\nCa = 2, Ce = 2, I = 0,50")
  Component(оплата, "Модуль «Оплата»", "Java-пакет", "Проведення оплат і повернень\nCa = 2, Ce = 1, I = 0,33")
  Component(спільне, "Модуль «Спільне»", "Java-пакет", "Ідентифікатори, гроші, базові події\nCa = 4, Ce = 0, I = 0,00")
}

Rel(сповіщення, замовлення, "Слухає події")
Rel(сповіщення, доставка, "Слухає події")
Rel(сповіщення, оплата, "Слухає події")
Rel(доставка, замовлення, "Слухає «ЗамовленняОплачено»")
Rel(замовлення, оплата, "провестиОплату()")
Rel(сповіщення, спільне, "Використовує")
Rel(доставка, спільне, "Використовує")
Rel(замовлення, спільне, "Використовує")
Rel(оплата, спільне, "Використовує")

skinparam legendFontColor #222222
skinparam legendBackgroundColor #FAFAFA
skinparam legendBorderColor #BBBBBB
legend right
  |<#85BBF0>   | компонент (модуль) |
  | - - - | межа контейнера |
  | Ca | доцентрові залежності (хто залежить від модуля) |
  | Ce | відцентрові залежності (від кого залежить модуль) |
  | I | нестабільність Ce / (Ca + Ce) |
endlegend
@enduml
