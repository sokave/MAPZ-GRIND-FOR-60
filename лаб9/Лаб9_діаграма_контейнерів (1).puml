@startuml
!include <C4/C4_Container>
title Діаграма контейнерів (C4, рівень 2): модульний моноліт сервісу доставки
LAYOUT_TOP_DOWN()
HIDE_STEREOTYPE()

Person(клієнт, "Клієнт", "Замовляє їжу, відстежує доставку")
Person(працівник, "Працівник закладу", "Приймає замовлення, оновлює меню")
Person(курʼєр, "Курʼєр", "Приймає пропозиції, доставляє замовлення")

Boundary(сервіс, "Сервіс доставки їжі", "програмна система") {
  Container(застКлієнта, "Застосунок клієнта", "Flutter", "Каталог, кошик, оплата, відстеження")
  Container(кабінет, "Кабінет закладу", "React, SPA", "Керування меню та замовленнями")
  Container(застКурʼєра, "Застосунок курʼєра", "Flutter", "Пропозиції, маршрут, підтвердження")
  Container(сервер, "Серверний застосунок", "Java 21, Spring Boot, модульний моноліт", "Модулі: замовлення, оплата, доставка, сповіщення; REST API")
  ContainerDb(бд, "База даних", "PostgreSQL", "Окрема схема для кожного модуля")
}

System_Ext(платіжний, "Платіжний шлюз", "Обробка банківських карток")
System_Ext(карти, "Картографічний сервіс", "Геокодування та маршрути")
System_Ext(push, "Сервіс push-сповіщень", "Доставка сповіщень на пристрої")

Rel(клієнт, застКлієнта, "Користується")
Rel(працівник, кабінет, "Користується")
Rel(курʼєр, застКурʼєра, "Користується")
Rel(застКлієнта, сервер, "Викликає API", "HTTPS/JSON")
Rel(кабінет, сервер, "Викликає API", "HTTPS/JSON")
Rel(застКурʼєра, сервер, "Викликає API", "HTTPS/JSON")
Rel(сервер, бд, "Читає й записує", "SQL")
Rel(сервер, платіжний, "Проводить оплату", "HTTPS")
Rel(сервер, карти, "Будує маршрути", "HTTPS")
Rel(сервер, push, "Надсилає сповіщення", "HTTPS")

skinparam legendFontColor #222222
skinparam legendBackgroundColor #FAFAFA
skinparam legendBorderColor #BBBBBB
legend right
  |<#08427B>   | особа (користувач) |
  |<#438DD5>   | контейнер |
  |<#999999>   | зовнішня система |
  | - - - | межа програмної системи |
endlegend
@enduml
