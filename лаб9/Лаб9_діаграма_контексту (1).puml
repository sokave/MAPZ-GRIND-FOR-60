@startuml
!include <C4/C4_Context>
title Діаграма контексту (C4, рівень 1): сервіс доставки їжі — версія для невеликої команди
LAYOUT_TOP_DOWN()
HIDE_STEREOTYPE()

Person(клієнт, "Клієнт", "Замовляє їжу, відстежує доставку")
Person(працівник, "Працівник закладу", "Приймає замовлення, оновлює меню")
Person(курʼєр, "Курʼєр", "Приймає пропозиції, доставляє замовлення")

System(сервіс, "Сервіс доставки їжі", "Замовлення страв у закладах міста та їх доставка курʼєрами")

System_Ext(платіжний, "Платіжний шлюз", "Обробка банківських карток")
System_Ext(карти, "Картографічний сервіс", "Геокодування та маршрути")
System_Ext(push, "Сервіс push-сповіщень", "Доставка сповіщень на пристрої")

Rel(клієнт, сервіс, "Оформлює й оплачує замовлення")
Rel(працівник, сервіс, "Приймає замовлення, керує меню")
Rel(курʼєр, сервіс, "Отримує пропозиції, підтверджує доставку")
Rel(сервіс, платіжний, "Проводить оплату", "HTTPS")
Rel(сервіс, карти, "Будує маршрути", "HTTPS")
Rel(сервіс, push, "Надсилає сповіщення", "HTTPS")

skinparam legendFontColor #222222
skinparam legendBackgroundColor #FAFAFA
skinparam legendBorderColor #BBBBBB
legend right
  |<#08427B>   | особа (користувач) |
  |<#1168BD>   | наша програмна система |
  |<#999999>   | зовнішня система |
endlegend
@enduml
